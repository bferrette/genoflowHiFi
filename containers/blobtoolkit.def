Bootstrap: docker
From: ubuntu:24.04

%labels
  Maintainer Bruno Ferrette
  Description BlobToolKit (BlobTools2 CLI + headless viewer) on Ubuntu 24.04, Python 3.9, pinned Firefox+Geckodriver, Chrome+Chromedriver, Xvfb, with bundled API/Viewer binaries
  Created 2025-10-02
  URL https://blobtoolkit.genomehubs.org/

%help
  BlobToolKit Singularity/Apptainer image with Python 3.9 and a headless browser stack.

  # Content
  - Python 3.9.21 built from source under /opt/python-3.9.21
  - Virtualenv at /opt/py39 (PEP 668 friendly)
  - blobtoolkit[full] (latest 4.x) in /opt/py39
  - Firefox (Mozilla official APT) + geckodriver v0.36.0
  - Google Chrome Stable + matching chromedriver
  - Xvfb + basic GL/GTK/NSS libs for headless rendering
  - **Standalone BlobToolKit API & Viewer binaries** installed into /usr/local/bin
  - Default Viewer/API config at /opt/blobtoolkit/conf/.env and launcher /opt/blobtoolkit/bin/start-viewer-api

  QUICK START (interactive viewer for a single BlobDir)
    apptainer exec -B /path/to/BlobDirs:/data this.sif \
      bash -lc "blobtools view --interactive /data/my_blobdir"
    # If accessing from a remote host, forward ports 8000 (API) and 8080 (Viewer)

  QUICK START (export plot SVG/PNG headlessly)
    apptainer exec -B /path/to/BlobDirs:/data this.sif \
      bash -lc "xvfb-run -a blobtools view --driver firefox --view snail --format svg --out /data/out /data/my_blobdir"

  ADVANCED (run Viewer+API explicitly with .env)
    apptainer exec -B /path/to/BlobDirs:/blobtoolkit/datasets this.sif \
      bash -lc "/opt/blobtoolkit/bin/start-viewer-api"
    # Then visit http://localhost:8080/view/all (API on 8000)

  NOTES
  - Newer BlobToolKit pip releases no longer bundle the Viewer/API; this image installs the official standalone binaries and puts them on PATH so 'blobtools view' can find them.
  - Mount your datasets under /blobtoolkit/datasets or adjust /opt/blobtoolkit/conf/.env.

%environment
  export LANG=en_US.UTF-8
  export LANGUAGE=en_US:en
  export LC_ALL=en_US.UTF-8
  export PATH=/opt/py39/bin:/usr/local/bin:$PATH
  export BROWSER=firefox
  export FIREFOX_BIN=/usr/local/bin/firefox
  export GECKODRIVER_BIN=/usr/local/bin/geckodriver
  export CHROME_BIN=/usr/bin/google-chrome-stable
  export CHROMEDRIVER_BIN=/usr/local/bin/chromedriver
  export MOZ_WEBRENDER=1
  export MOZ_ENABLE_WAYLAND=0
  export QT_X11_NO_MITSHM=1

%post
  bash -euxo pipefail <<'BASH'
  export DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC

  # ----- Base OS deps -----
  apt-get update && apt-get -y upgrade
  apt-get install -y --no-install-recommends \
      ca-certificates curl wget gnupg unzip bzip2 xz-utils jq \
      build-essential pkg-config libffi-dev libssl-dev zlib1g-dev libbz2-dev liblzma-dev \
      libreadline-dev libsqlite3-dev libncursesw5-dev libgdbm-dev tk-dev uuid-dev \
      locales procps xvfb nano vim fonts-liberation \
      libnss3 libatk1.0-0 libatk-bridge2.0-0 libx11-xcb1 libxss1 libxtst6 libxrandr2 libxkbcommon0 \
      libgtk-3-0t64 libgbm1 libnotify4 libasound2t64 libdrm2
  rm -rf /var/lib/apt/lists/*

  # ----- Locale -----
  sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen || true
  locale-gen en_US.UTF-8 || true
  update-ca-certificates || true

  # ----- Firefox from Mozilla official APT + geckodriver -----
  GECKO_VER=v0.36.0

  install -d -m 0755 /etc/apt/keyrings
  wget -q https://packages.mozilla.org/apt/repo-signing-key.gpg -O- \
    | tee /etc/apt/keyrings/packages.mozilla.org.asc >/dev/null
  GNUPGHOME="$(mktemp -d)"
  chmod 700 "${GNUPGHOME}"
  gpg --batch --homedir "${GNUPGHOME}" -n -q --import --import-options import-show /etc/apt/keyrings/packages.mozilla.org.asc \
    | awk '/pub/{getline; gsub(/^ +| +$/,""); if($0 != "35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3") exit 1 }' \
    || { echo "Mozilla APT key fingerprint verification failed" >&2; exit 1; }
  rm -rf "${GNUPGHOME}"
  cat >/etc/apt/sources.list.d/mozilla.sources <<'SRC'
Types: deb
URIs: https://packages.mozilla.org/apt
Suites: mozilla
Components: main
Signed-By: /etc/apt/keyrings/packages.mozilla.org.asc
SRC
  cat >/etc/apt/preferences.d/mozilla <<'PREF'
Package: *
Pin: origin packages.mozilla.org
Pin-Priority: 1000
PREF

  apt-get update
  apt-get install -y --no-install-recommends firefox
  rm -rf /var/lib/apt/lists/*
  FIREFOX_REAL_BIN="$(
    command -v firefox 2>/dev/null \
      || command -v firefox-esr 2>/dev/null \
      || find /usr /opt -type f \( -name firefox -o -name firefox-bin -o -name firefox-esr \) -perm -111 2>/dev/null | head -n1
  )"
  [[ -n "${FIREFOX_REAL_BIN}" ]] || { echo "Firefox binary not found after Mozilla APT installation" >&2; exit 1; }
  ln -sfn "${FIREFOX_REAL_BIN}" /usr/local/bin/firefox

  cd /usr/local/bin
  curl -fsSL -o geckodriver.tgz "https://github.com/mozilla/geckodriver/releases/download/${GECKO_VER}/geckodriver-${GECKO_VER}-linux64.tar.gz"
  tar -xzf geckodriver.tgz && rm -f geckodriver.tgz
  chmod 0755 /usr/local/bin/geckodriver

  # ----- Google Chrome Stable + matching chromedriver -----
  install -d -m 0755 /etc/apt/keyrings
  curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
    | gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg
  cat >/etc/apt/sources.list.d/google-chrome.list <<'SRC'
deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main
SRC

  apt-get update
  apt-get install -y --no-install-recommends google-chrome-stable
  ln -sfn /usr/bin/google-chrome-stable /usr/local/bin/google-chrome
  ln -sfn /usr/bin/google-chrome-stable /usr/local/bin/chromium
  ln -sfn /usr/bin/google-chrome-stable /usr/local/bin/chromium-browser
  rm -rf /var/lib/apt/lists/*

  CHROME_MAJOR="$(/usr/bin/google-chrome-stable --version | awk '{print $3}' | cut -d. -f1)"
  CHROMEDRIVER_VER="$(curl -fsSL "https://googlechromelabs.github.io/chrome-for-testing/LATEST_RELEASE_${CHROME_MAJOR}")"
  cd /tmp
  curl -fsSL -o chromedriver.zip \
    "https://storage.googleapis.com/chrome-for-testing-public/${CHROMEDRIVER_VER}/linux64/chromedriver-linux64.zip"
  unzip -q chromedriver.zip
  install -m 0755 chromedriver-linux64/chromedriver /usr/local/bin/chromedriver
  rm -rf /tmp/chromedriver.zip /tmp/chromedriver-linux64

  # ----- Build Python 3.9.21 from source -----
  PYVER=3.9.21
  cd /opt
  curl -fsSL -o Python-${PYVER}.tgz https://www.python.org/ftp/python/${PYVER}/Python-${PYVER}.tgz
  tar -xzf Python-${PYVER}.tgz && rm -f Python-${PYVER}.tgz
  cd Python-${PYVER}
  ./configure --prefix=/opt/python-${PYVER} --enable-optimizations --with-ensurepip=install
  make -j"$(nproc)" && make install
  ln -sf /opt/python-${PYVER}/bin/python3 /usr/local/bin/python3.9

  # ----- Isolated venv (PEP 668 friendly) -----
  /opt/python-${PYVER}/bin/python3 -m venv /opt/py39
  /opt/py39/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel

  # ----- BlobToolKit CLI (pip) -----
  # Silence pkg_resources deprecation noise by keeping setuptools<81 on Py3.9
  /opt/py39/bin/pip install --no-cache-dir --upgrade pip wheel
  /opt/py39/bin/pip install --no-cache-dir 'setuptools<81'
  /opt/py39/bin/pip install --no-cache-dir 'blobtoolkit[full]' --upgrade
  /opt/py39/bin/pip install --no-cache-dir 'chromedriver-sync' --upgrade

  # Convenience symlinks
  ln -sf /opt/py39/bin/blobtools /usr/local/bin/blobtools
  ln -sf /opt/py39/bin/python   /usr/local/bin/python
  ln -sf /opt/py39/bin/pip      /usr/local/bin/pip
  ln -sf /opt/py39/bin/blobtools /usr/local/bin/blobtools
  ln -sf /opt/py39/bin/python   /usr/local/bin/python
  ln -sf /opt/py39/bin/pip      /usr/local/bin/pip

  # ----- Install BlobToolKit API + Viewer binaries (from official releases) -----
  # Use the "blobtoolkit/blobtoolkit" release page per wiki instructions
  BTK_RELEASE=4.5.0
  PLATFORM=linux
  curl -fsSL -o /usr/local/bin/blobtoolkit-api \
    "https://github.com/blobtoolkit/blobtoolkit/releases/download/${BTK_RELEASE}/blobtoolkit-api-${PLATFORM}"
  curl -fsSL -o /usr/local/bin/blobtoolkit-viewer \
    "https://github.com/blobtoolkit/blobtoolkit/releases/download/${BTK_RELEASE}/blobtoolkit-viewer-${PLATFORM}"
  chmod 0755 /usr/local/bin/blobtoolkit-api /usr/local/bin/blobtoolkit-viewer

  # ----- Bundle default Viewer/API config and launcher -----
  # Ensure config dirs exist before writing files
  install -d -m 0755 /opt/blobtoolkit/conf /opt/blobtoolkit/bin /blobtoolkit/datasets /blobtoolkit/output
  cat >/opt/blobtoolkit/conf/.env <<'ENVEOF'
# ===== BlobToolKit Viewer/API defaults =====
# Listener addresses (0.0.0.0 for containerised use)
API_HOST=0.0.0.0
API_PORT=8000
VIEWER_HOST=0.0.0.0
VIEWER_PORT=8080
# Paths inside container
DATASETS_DIR=/blobtoolkit/datasets
OUTPUT_DIR=/blobtoolkit/output
# Public URLs (used by viewer to reach API)
PUBLIC_URL=http://localhost:${VIEWER_PORT}
API_URL=http://localhost:${API_PORT}
ENVEOF

  cat >/opt/blobtoolkit/bin/start-viewer-api <<'SH'
#!/usr/bin/env bash
set -euo pipefail
source /opt/blobtoolkit/conf/.env
export DATASETS_DIR OUTPUT_DIR API_URL PUBLIC_URL
# Start API+Viewer using blobtools host (which discovers blobtoolkit-api/viewer on PATH)
nohup blobtools host "${DATASETS_DIR}" --api-host "${API_HOST}" --api-port "${API_PORT}" \
  --viewer-host "${VIEWER_HOST}" --viewer-port "${VIEWER_PORT}" >/tmp/btk_host.log 2>&1 &
# Wait briefly and show status
sleep 2
echo "API:    http://localhost:${API_PORT}"
echo "Viewer: http://localhost:${VIEWER_PORT}"
echo "Logs:   /tmp/btk_host.log"
SH
  chmod +x /opt/blobtoolkit/bin/start-viewer-api

  # Sanity checks
  command -v firefox >/dev/null 2>&1
  firefox --version
  command -v geckodriver >/dev/null 2>&1
  geckodriver --version
  command -v chromedriver >/dev/null 2>&1
  chromedriver --version
  command -v /usr/bin/google-chrome-stable >/dev/null 2>&1
  /usr/bin/google-chrome-stable --version
  command -v google-chrome >/dev/null 2>&1
  google-chrome --version
  command -v chromium >/dev/null 2>&1
  chromium --version
  command -v chromium-browser >/dev/null 2>&1
  chromium-browser --version
  blobtools --version
  command -v blobtoolkit-api >/dev/null 2>&1
  command -v blobtoolkit-viewer >/dev/null 2>&1
BASH

%runscript
  # Default to showing blobtools help
  exec /bin/bash -lc "source /environment >/dev/null 2>&1 || true; blobtools --help"

%test
  bash -lc "python --version && blobtools --version && command -v firefox && firefox --version && command -v geckodriver && geckodriver --version && command -v /usr/bin/google-chrome-stable && /usr/bin/google-chrome-stable --version && command -v google-chrome && google-chrome --version && command -v chromedriver && chromedriver --version && command -v blobtoolkit-api && command -v blobtoolkit-viewer"
