Bootstrap: docker
From: ubuntu:24.04

%labels
  Maintainer Bruno Ferrette
  Description RepeatMasker/RepeatModeler toolchain + TEtrimmer (Ubuntu 24.04, PEP-668 venv)
  Source Hybrid: tarballs (HMMER, RepeatMasker, RMBlast, RECON, RepeatModeler, RepeatScout, LTR_retriever, RepeatAfterMe, NINJA, COSEG), git (TRF, cd-hit, TEtrimmer)
  Note Bind external Dfam/RepBase libs at runtime: -B /data/rm_libs/Libraries:/opt/RepeatMasker/Libraries

%environment
  export LANG=en_US.UTF-8
  export LANGUAGE=en_US:en
  export LC_ALL=en_US.UTF-8

  export REPEATMODELER_DIR=/opt/RepeatModeler
  export BLAST_USAGE_REPORT=false

  # Keep host Perl out; force container-only libs
  unset PERL5LIB PERL_LOCAL_LIB_ROOT PERL_MB_OPT PERL_MM_OPT PERL5OPT
  export PERL5LIB=/opt/RepeatMasker:/opt/RepeatMasker/Libraries

  # Toolchain PATHs
  export PATH=/opt/venv/bin:$PATH
  export PATH=/opt/RepeatMasker:/opt/RepeatMasker/util:$PATH
  export PATH=/opt/RepeatModeler:/opt/RepeatModeler/util:$PATH
  export PATH=/opt/ucsc_tools:$PATH
  export PATH=/opt/hmmer/bin:$PATH
  export PATH=/opt/genometools/bin:$PATH
  export PATH=/opt/trf/bin:$PATH
  export PATH=/opt/cd-hit/bin:$PATH
  export PATH=/opt/NINJA:$PATH
  export PATH=/opt/RepeatScout:$PATH
  export PATH=/opt/RECON/bin:$PATH
  export PATH=/opt/TEtrimmer/tetrimmer:$PATH
  export PATH=$PATH:/opt/rmblast/bin

%post
#!/bin/bash -euxo pipefail
export DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC

apt update && apt -y upgrade
apt install -y --no-install-recommends \
  ca-certificates curl wget git unzip bzip2 xz-utils \
  gawk coreutils build-essential pkg-config autoconf automake libtool \
  libbz2-dev zlib1g-dev liblzma-dev libssl-dev libcurl4-openssl-dev libdeflate-dev libzstd-dev \
  libncurses-dev libc6-dev libc-bin locales \
  python3 python3-dev python-is-python3 python3-pip python3-venv python3-h5py python3-tk \
  parallel pigz gzip seqtk \
  libgomp1 perl libfile-which-perl libtext-soundex-perl \
  libjson-perl liburi-perl libwww-perl libdevel-size-perl \
  libdbd-sqlite3-perl sqlite3 \
  libcairo2-dev libpango1.0-dev libglib2.0-dev libpixman-1-dev libfontconfig1-dev libfreetype-dev libpng-dev \
  ghostscript emboss iqtree \
  r-base r-cran-rcpp r-bioc-biostrings \
  procps
rm -rf /var/lib/apt/lists/*

# Locale
sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen || true
locale-gen en_US.UTF-8 || true
update-ca-certificates || true

# Python venv (PEP 668); install stack via pip
VENV=/opt/venv
python3 -m venv "$VENV"
"$VENV/bin/python" -m pip install --no-cache-dir --upgrade pip setuptools wheel
"$VENV/bin/pip" install --no-cache-dir \
  numpy scipy matplotlib pandas pycurl h5py \
  biopython PyPDF2 \
  click dataclasses dill joblib multiprocess plotly regex requests seaborn scikit-learn tk urllib3
ln -sf "$VENV/bin/python" /usr/local/bin/python
ln -sf "$VENV/bin/python" /usr/local/bin/python3
ln -sf "$VENV/bin/pip"    /usr/local/bin/pip

mkdir -p /opt/build && cd /opt/build

# ---- Versions (override via build-args if desired) ----
HTSLIB_VERSION=${HTSLIB_VERSION:-1.23}
SAMTOOLS_VERSION=${SAMTOOLS_VERSION:-1.23}
export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:${PKG_CONFIG_PATH:-}

# ---- HTSlib ----
HTS_TARBALL="htslib-${HTSLIB_VERSION}.tar.bz2"
HTS_URL="https://github.com/samtools/htslib/releases/download/${HTSLIB_VERSION}/${HTS_TARBALL}"
curl -fsSL -o "$HTS_TARBALL" "$HTS_URL"
tar -xjf "$HTS_TARBALL"
cd "htslib-${HTSLIB_VERSION}"
./configure --enable-libcurl --enable-plugins
make -j"$(nproc)"
make install
ldconfig || true
cd /opt/build && rm -rf "htslib-${HTSLIB_VERSION}" "$HTS_TARBALL"

# ---- SAMtools ----
SAM_TARBALL="samtools-${SAMTOOLS_VERSION}.tar.bz2"
SAM_URL="https://github.com/samtools/samtools/releases/download/${SAMTOOLS_VERSION}/${SAM_TARBALL}"
curl -fsSL -o "$SAM_TARBALL" "$SAM_URL"
tar -xjf "$SAM_TARBALL"
cd "samtools-${SAMTOOLS_VERSION}"
./configure --with-htslib=/usr/local --with-curses
make -j"$(nproc)"
make install
cd /opt/build && rm -rf "samtools-${SAMTOOLS_VERSION}" "$SAM_TARBALL"

# ---- BEDtools2 ----
git clone --depth 1 https://github.com/arq5x/bedtools2.git /opt/bedtools2
make -C /opt/bedtools2 -j"$(nproc)"
ln -sf /opt/bedtools2/bin/* /usr/local/bin/

# ===== HMMER 3.4 =====
curl -fsSL http://eddylab.org/software/hmmer/hmmer.tar.gz -o hmmer.tar.gz
tar -xzf hmmer.tar.gz
cd hmmer-3.4
./configure --prefix=/opt/hmmer
make -j"$(nproc)"
make check || true
make install
make -C easel install prefix=/opt/hmmer
cd /opt/build && rm -rf hmmer-3.4 hmmer.tar.gz

# ===== TRF =====
git clone --depth 1 https://github.com/Benson-Genomics-Lab/TRF.git /opt/trf-src
cd /opt/trf-src && mkdir -p build && cd build
../configure --prefix=/opt/trf
make -j"$(nproc)"
make install
ln -sf /opt/trf/bin/trf /opt/trf/trf
cd /opt/build && rm -rf /opt/trf-src

# ===== RepeatScout 1.0.7 =====
RSCOUT_VER=1.0.7
RSCOUT_URL="https://github.com/Dfam-consortium/RepeatScout/archive/refs/tags/v${RSCOUT_VER}.tar.gz"
curl -fsSL "$RSCOUT_URL" -o RepeatScout.tar.gz
tar -xzf RepeatScout.tar.gz
cd "RepeatScout-${RSCOUT_VER}"
make -j"$(nproc)"
install -d /opt/RepeatScout
for f in RepeatScout build_lmer_table filter-stage-1.prl filter-stage-2.prl; do
  if [ -f "$f" ]; then install -m 0755 "$f" /opt/RepeatScout/; fi
done
if [ -f LICENSE ]; then install -m 0644 LICENSE /opt/RepeatScout/; fi
cd /opt/build && rm -rf "RepeatScout-${RSCOUT_VER}" RepeatScout.tar.gz

# ===== RECON 1.08 =====
cd /opt
curl -fsSL http://www.repeatmasker.org/RECON-1.08.tar.gz -o RECON-1.08.tar.gz
tar -xzf RECON-1.08.tar.gz && rm -f RECON-1.08.tar.gz
mv RECON-1.08 RECON
make -C /opt/RECON/src -j"$(nproc)"
make -C /opt/RECON/src install
cd /opt/RECON && mkdir -p /opt/RECON/bin
find /opt/RECON/src -maxdepth 1 -type f -perm -111 -exec cp -f {} /opt/RECON/bin/ \; || true
if [ -f 00README ]; then cp -f 00README /opt/RECON/bin/; fi
sed -i 's#^\$path =.*#$path = "/opt/RECON/bin";#' /opt/RECON/scripts/recon.pl

# ===== cd-hit 4.8.1 (+ aux) =====
cd /opt/build
git clone --depth 1 --branch V4.8.1 https://github.com/weizhongli/cdhit.git cd-hit-src
cd cd-hit-src && make -j"$(nproc)"
install -d /opt/cd-hit/bin
make install PREFIX=/opt/cd-hit || true
for f in cd-hit cd-hit-2d cd-hit-est cd-hit-est-2d cd-hit-454 clstr2tree clstr_list_sort clstr_merge cd-hit-div cd-hit-lap cd-hit-para; do
  if [ -f "$f" ]; then install -m 0755 "$f" /opt/cd-hit/bin/; fi
done
cd cd-hit-auxtools && make -j"$(nproc)"
find . -maxdepth 1 -type f -perm -111 -exec install -m 0755 {} /opt/cd-hit/bin/ \; || true
find . -maxdepth 1 -type f -name "*.pl" -exec install -m 0755 {} /opt/cd-hit/bin/ \; || true
cd /opt/build && rm -rf /opt/build/cd-hit-src

# ===== GenomeTools / LTRharvest v1.6.5 (with Cairo/Pango) =====
cd /opt/build && curl -fsSL https://github.com/genometools/genometools/archive/refs/tags/v1.6.5.tar.gz -o genometools.tar.gz
tar -xzf genometools.tar.gz && cd genometools-1.6.5
make -j"$(nproc)" threads=yes cairo=yes
make threads=yes cairo=yes prefix=/opt/genometools install
make cleanup || true
cd /opt/build
/opt/genometools/bin/gt -version || { echo "[ERR] genometools not runnable"; exit 1; }
ln -sf /opt/genometools/bin/gt /usr/local/bin/gt
rm -rf genometools-1.6.5 genometools.tar.gz

# ===== LTR_retriever v2.9.0 =====
curl -fsSL "https://github.com/oushujun/LTR_retriever/archive/refs/tags/v2.9.0.tar.gz" -o LTR_retriever.tar.gz
tar -xzf LTR_retriever.tar.gz && rm -f LTR_retriever.tar.gz
mv LTR_retriever-2.9.0 /opt/LTR_retriever
sed -i \
  -e 's#BLAST+=#BLAST+=/opt/rmblast/bin#' \
  -e 's#RepeatMasker=#RepeatMasker=/opt/RepeatMasker#' \
  -e 's#HMMER=#HMMER=/opt/hmmer/bin#' \
  -e 's#CDHIT=#CDHIT=/opt/cd-hit/bin#' \
  /opt/LTR_retriever/paths

# ===== MAFFT 7.526-1 (.deb) =====
curl -fsSL "https://mafft.cbrc.jp/alignment/software/mafft_7.526-1_amd64.deb" -o mafft_7.526-1_amd64.deb
dpkg -i mafft_7.526-1_amd64.deb || { apt update && apt -y -f install; }
rm -f mafft_7.526-1_amd64.deb
rm -rf /var/lib/apt/lists/*

# ===== NINJA 1.00-cluster_only =====
cd /opt/build
curl -fsSL "https://github.com/TravisWheelerLab/NINJA/archive/refs/tags/1.00-cluster_only.tar.gz" -o NINJA.tar.gz
tar -xzf NINJA.tar.gz
cd NINJA-1.00-cluster_only/NINJA
make clean || true
make -j"$(nproc)"
install -d /opt/NINJA
BIN_NAME=NINJA; if [ -f Ninja ]; then BIN_NAME=Ninja; fi
install -m 0755 "$BIN_NAME" /opt/NINJA/
cd /opt/build && rm -rf NINJA-1.00-cluster_only NINJA.tar.gz

# ===== UCSC tools (prebuilt) =====
mkdir -p /opt/ucsc_tools
curl -fsSL https://hgdownload.soe.ucsc.edu/admin/exe/linux.x86_64/faToTwoBit  -o /opt/ucsc_tools/faToTwoBit
curl -fsSL https://hgdownload.soe.ucsc.edu/admin/exe/linux.x86_64/twoBitInfo  -o /opt/ucsc_tools/twoBitInfo
curl -fsSL https://hgdownload.soe.ucsc.edu/admin/exe/linux.x86_64/twoBitToFa  -o /opt/ucsc_tools/twoBitToFa
chmod 0755 /opt/ucsc_tools/faToTwoBit /opt/ucsc_tools/twoBitInfo /opt/ucsc_tools/twoBitToFa
ln -sf /opt/ucsc_tools/faToTwoBit /usr/local/bin/faToTwoBit
ln -sf /opt/ucsc_tools/twoBitInfo /usr/local/bin/twoBitInfo
ln -sf /opt/ucsc_tools/twoBitToFa /usr/local/bin/twoBitToFa

# ===== RMBlast 2.14.1+ =====
cd /opt/build
mkdir -p /opt/rmblast
curl -fsSL "https://www.repeatmasker.org/rmblast/rmblast-2.14.1+-x64-linux.tar.gz" -o rmblast.tgz
tar --strip-components=1 -xzf rmblast.tgz -C /opt/rmblast
rm -f rmblast.tgz

# ===== RepeatMasker 4.2.2 =====
cd /opt/build
curl -fsSL "https://www.repeatmasker.org/RepeatMasker/RepeatMasker-4.2.2.tar.gz" -o RepeatMasker-4.2.2.tar.gz
tar -xzf RepeatMasker-4.2.2.tar.gz -C /opt && rm -f RepeatMasker-4.2.2.tar.gz
cd /opt/RepeatMasker
mkdir -p Libraries/famdb
chmod -R a+w Libraries Libraries/famdb || true
# Ensure BOTH system and venv Pythons can import h5py; prefer venv
export PATH=/opt/venv/bin:$PATH

echo "[DEBUG] Verifying h5py in both Pythons ..."
for PY in /opt/venv/bin/python3 /usr/bin/python3; do
  if [ -x "$PY" ]; then
    if ! "$PY" - <<'PY'
import h5py, sys
print("OK:", sys.executable, h5py.__version__)
PY
    then
      if [ "$PY" = "/usr/bin/python3" ]; then
        apt-get update && apt-get install -y --no-install-recommends python3-h5py || true
      fi
      "$PY" -m pip install --no-cache-dir --break-system-packages h5py || true
      "$PY" - <<'PY'
import h5py, sys
print("OK(after-fix):", sys.executable, h5py.__version__)
PY
    fi
  fi
done

perl configure \
  -hmmer_dir=/opt/hmmer/bin \
  -rmblast_dir=/opt/rmblast/bin \
  -libdir=/opt/RepeatMasker/Libraries \
  -trf_prgm=/opt/trf/bin/trf \
  -default_search_engine=rmblast

# Stash pristine base libs inside SIF for export
cp -a /opt/RepeatMasker/Libraries /opt/RepeatMasker/Libraries.internal
# Make the module available in both expected locations
if [ -f /opt/RepeatMasker/Libraries/RepeatAnnotationData.pm ]; then
  cp -f /opt/RepeatMasker/Libraries/RepeatAnnotationData.pm /opt/RepeatMasker/RepeatAnnotationData.pm || true
fi

# ===== RepeatAfterMe v0.0.7 =====
cd /opt/build
curl -fsSL "https://github.com/Dfam-consortium/RepeatAfterMe/archive/refs/tags/RepeatAfterMe_V0.0.7.tar.gz" -o RepeatAfterMe.tgz
tar -xzf RepeatAfterMe.tgz && rm -f RepeatAfterMe.tgz
RAM_SRC_DIR="$(find . -maxdepth 1 -type d -name 'RepeatAfterMe-RepeatAfterMe_V0.0.7' -print -quit)"
cd "$RAM_SRC_DIR"
make -j"$(nproc)"
make INSTDIR=/opt/RepeatAfterMe install
install -d /opt/RepeatAfterMe/util
for u in util/extend-stk.pl util/calcPaths.pl util/davidExtendConsRAM.pl; do
  [ -f "$u" ] && install -m 0755 "$u" /opt/RepeatAfterMe/util/ || true
done
if [ -x /opt/RepeatAfterMe/bin/RAMExtend ]; then
  ln -sf /opt/RepeatAfterMe/bin/RAMExtend /usr/local/bin/RAMExtend
  ln -sf /opt/RepeatAfterMe/bin/RAMExtend /opt/RepeatAfterMe/RAMExtend
else
  echo "[ERR] RAMExtend missing after install" >&2; exit 13
fi

# ===== COSEG 0.2.4 =====
cd /opt/build
curl -fsSL "https://github.com/rmhubley/coseg/archive/refs/tags/coseg-0.2.4.tar.gz" -o coseg-0.2.4.tar.gz
tar -xzf coseg-0.2.4.tar.gz && rm -f coseg-0.2.4.tar.gz
COSEG_SRC_DIR=$(find . -maxdepth 1 -type d -name 'coseg-*0.2.4' -print -quit)
cd "$COSEG_SRC_DIR"
CFLAGS="${CFLAGS:-} -O3 -pipe -fPIC -DNDEBUG" make -j"$(nproc)"
if [ ! -f README ]; then
  if [ -f README.md ]; then cp README.md README; else echo "COSEG 0.2.4" > README; fi
fi
sed -i 's#^ *use lib "/.*RepeatMasker";#use lib "/opt/RepeatMasker";#' preprocessAlignments.pl
sed -i '1s|^#!.*perl|#!/usr/bin/perl|' preprocessAlignments.pl runcoseg.pl refineConsSeqs.pl || true
make install INSTALLDIR=/opt/coseg
find /opt/coseg -maxdepth 1 -type f -exec chmod a+rx {} \; || true
command -v strip >/dev/null 2>&1 && strip /opt/coseg/coseg || true
install -d /usr/local/bin
ln -sf /opt/coseg/coseg                    /usr/local/bin/coseg
ln -sf /opt/coseg/preprocessAlignments.pl  /usr/local/bin/preprocessAlignments.pl
ln -sf /opt/coseg/runcoseg.pl              /usr/local/bin/runcoseg.pl
ln -sf /opt/coseg/refineConsSeqs.pl        /usr/local/bin/refineConsSeqs.pl
ln -sf /opt/coseg/extractSubSeqs.pl        /usr/local/bin/extractSubSeqs.pl

# ===== RepeatModeler 2.0.7 =====
cd /opt/build
curl -fsSL "https://github.com/Dfam-consortium/RepeatModeler/archive/refs/tags/2.0.7.tar.gz" -o RepeatModeler-2.0.7.tar.gz
tar -xzf RepeatModeler-2.0.7.tar.gz && rm -f RepeatModeler-2.0.7.tar.gz
mv RepeatModeler-2.0.7 /opt/RepeatModeler
cd /opt/RepeatModeler
perl configure \
  -cdhit_dir=/opt/cd-hit/bin \
  -genometools_dir=/opt/genometools/bin \
  -ltr_retriever_dir=/opt/LTR_retriever \
  -mafft_dir=/usr/bin \
  -ninja_dir=/opt/NINJA \
  -recon_dir=/opt/RECON/bin \
  -repeatmasker_dir=/opt/RepeatMasker \
  -rmblast_dir=/opt/rmblast/bin \
  -rscout_dir=/opt/RepeatScout \
  -trf_dir=/opt/trf/bin \
  -ucsctools_dir=/opt/ucsc_tools \
  -repeatafterme_dir=/opt/RepeatAfterMe

# ===== nseg (source build) =====
cd /opt
rm -rf /opt/nseg || true
git clone https://github.com/jebrosen/nseg /opt/nseg
cd /opt/nseg
make -j"$(nproc)"
install -m 0755 nseg /usr/local/bin/nseg

# ===== pfam_scan (source install) =====
cd /opt
rm -rf /opt/pfam_scan || true
git clone https://github.com/aziele/pfam_scan /opt/pfam_scan
chmod +x /opt/pfam_scan/pfam_scan.py
ln -sf /opt/pfam_scan/pfam_scan.py /usr/local/bin/pfam_scan

# ===== TEtrimmer (source; scripts on PATH) =====
cd /opt
git clone --depth 1 https://github.com/qjiangzhao/TEtrimmer.git /opt/TEtrimmer
cd /opt/TEtrimmer/tetrimmer
chmod +x *.py
# Ensure venv deps are present (repeat here so layer stays valid if upstream changes)
/opt/venv/bin/pip install --no-cache-dir biopython PyPDF2

# ----- Helper: copy in-image base Libraries to a bound external dir (exclude famdb) -----
cat >/usr/local/bin/rm_copy_base_libs.sh <<'EOSH'
#!/usr/bin/env bash
set -euo pipefail
SRC="/opt/RepeatMasker/Libraries.internal"
DST="/opt/RepeatMasker/Libraries"
if [ ! -d "$SRC" ]; then
  echo "[ERR] Source $SRC not found in image" >&2
  exit 2
fi
mkdir -p "$DST"
( cd "$SRC" && tar --exclude='./famdb' -cf - . ) | ( cd "$DST" && tar -xpf - )
echo "[OK] Copied base RepeatMasker Libraries (excluding famdb) to $DST"
EOSH
chmod 0755 /usr/local/bin/rm_copy_base_libs.sh

# ---- Global symlinks ----
install -d /usr/local/bin
ln -sf /opt/RepeatMasker/RepeatMasker   /usr/local/bin/RepeatMasker
ln -sf /opt/RepeatModeler/RepeatModeler /usr/local/bin/RepeatModeler
ln -sf /opt/RepeatModeler/BuildDatabase /usr/local/bin/BuildDatabase
ln -sf /opt/genometools/bin/gt          /usr/local/bin/gt
ln -sf /opt/trf/bin/trf                 /usr/local/bin/trf

for f in /opt/hmmer/bin/*; do ln -sf "$f" /usr/local/bin/"$(basename "$f")"; done
for f in /opt/rmblast/bin/*; do ln -sf "$f" /usr/local/bin/"$(basename "$f")"; done
for f in /opt/ucsc_tools/*; do ln -sf "$f" /usr/local/bin/"$(basename "$f")"; done
for f in cd-hit cd-hit-est cd-hit-2d cd-hit-est-2d cd-hit-454 clstr2tree clstr_list_sort clstr_merge; do
  [ -x "/opt/cd-hit/bin/$f" ] && ln -sf "/opt/cd-hit/bin/$f" "/usr/local/bin/$f" || true
done

if [ -x /opt/NINJA/NINJA ]; then
  ln -sf /opt/NINJA/NINJA /usr/local/bin/NINJA
  ln -sf /opt/NINJA/NINJA /usr/local/bin/Ninja
elif [ -x /opt/NINJA/Ninja ]; then
  ln -sf /opt/NINJA/Ninja /usr/local/bin/Ninja
  ln -sf /opt/NINJA/Ninja /usr/local/bin/NINJA
fi

[ -x /opt/RepeatAfterMe/bin/RAMExtend ] && ln -sf /opt/RepeatAfterMe/bin/RAMExtend /usr/local/bin/RAMExtend || true
[ -x /opt/RepeatScout/RepeatScout ] && ln -sf /opt/RepeatScout/RepeatScout /usr/local/bin/RepeatScout || true
[ -x /opt/RepeatScout/build_lmer_table ] && ln -sf /opt/RepeatScout/build_lmer_table /usr/local/bin/build_lmer_table || true
[ -x /opt/RepeatScout/filter-stage-1.prl ] && ln -sf /opt/RepeatScout/filter-stage-1.prl /usr/local/bin/filter-stage-1.prl || true
[ -x /opt/RepeatScout/filter-stage-2.prl ] && ln -sf /opt/RepeatScout/filter-stage-2.prl /usr/local/bin/filter-stage-2.prl || true

if [ -d /opt/RECON/bin ]; then
  for f in /opt/RECON/bin/*; do [ -x "$f" ] && ln -sf "$f" /usr/local/bin/"$(basename "$f")" || true; done
fi

# Shell prompt
echo "PS1='(dfam-tetools \w)\$ '" >> /etc/bash.bashrc

%runscript
exec bash -l "$@"

%help
Build:
  sudo singularity build repeatmasker.sif rep.def

Bind & seed an external Libraries dir (copy in-image base libs, exclude famdb):
  singularity run -B /data/rm_libs/Libraries:/opt/RepeatMasker/Libraries repeatmasker.sif rm_copy_base_libs.sh

Quick checks:
  singularity run -B /data/rm_libs/Libraries:/opt/RepeatMasker/Libraries -B "$PWD":"$PWD" --pwd "$PWD" repeatmasker.sif \
    bash -lc 'RepeatMasker -version; RepeatModeler -help; python3 -c "import Bio, PyPDF2; print(\"biopython OK\")"; ls -1 /opt/TEtrimmer/tetrimmer/*.py | head'

Typical workflow inside a run shell:
  BuildDatabase -name genome1 genome1.fa
  RepeatModeler -database genome1 -threads 24
  RepeatMasker -pa 24 -e rmblast -lib 01.repeatmodeler/families.fa genome1.fa

TEtrimmer (scripts):
  ls /opt/TEtrimmer/tetrimmer/*.py
  # call desired TEtrimmer python modules directly, e.g.
  # python /opt/TEtrimmer/tetrimmer/<script>.py --help
